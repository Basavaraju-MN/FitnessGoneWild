# Admin API (apps/admin-server). Copy to .env and fill in.
PORT=4100
NODE_ENV=development

# Same database as the website
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fgonewild

# Long random string; changing it logs everyone out
JWT_SECRET=change-me-to-a-long-random-string

# Admin app address(es), comma separated
ADMIN_ORIGIN=http://localhost:5175
