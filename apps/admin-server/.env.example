# Admin API (apps/admin-server). Copy to .env and fill in.
PORT=4100
NODE_ENV=development

# Database: same as the website, from apps/server/src/config/database.js
# (set DB_HOST, DB_USER, DB_PASSWORD, DB_NAME as environment variables to override)

# Long random string; changing it logs everyone out
JWT_SECRET=change-me-to-a-long-random-string

# Admin app address(es), comma separated
ADMIN_ORIGIN=http://localhost:5175
