# Server
PORT=4000
NODE_ENV=development

# Client URL(s), comma-separated
CLIENT_URL=http://localhost:5173

# Hostinger/MySQL (production values must be set in Render)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fgonewild
DB_USER=root
DB_PASSWORD=

DB_CONNECTION_LIMIT=10

# PhonePe
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_REDIRECT_URL=http://localhost:5173/payment-result
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Python command used by the PhonePe integration
PYTHON_COMMAND=python3
